#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Ahead-of-time compile CLI.
 *
 * Usage:
 *   php bin/ray-di-compile <bootstrap> <appDir> <context> [compileDir] [tmpDir]
 *
 * Everything except locating the autoloader lives in NaokiTsuchiya\RayDiContext\Cli, which the
 * analyzer and the coverage floor can reach. The lookup below cannot move there: it is what
 * makes that class loadable in the first place.
 *
 * The bootstrap file is a PHP script that returns a ContextProviderInterface. See the README
 * for the argument and exit-status contract (0 compiled, 1 the compile failed, 2 usage error).
 */

use NaokiTsuchiya\RayDiContext\Cli;

(static function (): void {
    foreach ([
        // Set by Composer's bin proxy and pointing at the consumer's autoloader. Tried first
        // because the candidates below resolve to this package's own vendor dir whenever it
        // has one — a path repository, a monorepo checkout, local development — and loading
        // that one leaves the consumer's own classes, its contexts included, unloadable.
        $GLOBALS['_composer_autoload_path'] ?? null,
        __DIR__ . '/../vendor/autoload.php', // installed as the root package
        __DIR__ . '/../../../autoload.php', // installed as a dependency (vendor/bin)
    ] as $autoload) {
        if (is_string($autoload) && is_file($autoload)) {
            require $autoload;

            return;
        }
    }
})();

if (!class_exists(Cli::class)) {
    fwrite(STDERR, "Could not locate the Composer autoloader. Run 'composer install' first.\n");

    exit(1);
}

/** @var list<string> $argv */
exit((new Cli())($argv));
