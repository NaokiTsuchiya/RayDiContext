#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Ahead-of-time compile CLI.
 *
 * Usage:
 *   php bin/ray-di-compile <bootstrap> <appDir> <context> [compileDir] [tmpDir]
 *
 * Everything but the autoloader lookup lives in NaokiTsuchiya\RayDiContext\Cli; the lookup
 * cannot move there, since it is what makes that class loadable.
 *
 * The bootstrap file is a PHP script that returns a ContextProviderInterface. See the README
 * for the argument and exit-status contract (0 compiled, 1 the compile failed, 2 usage error).
 */

use NaokiTsuchiya\RayDiContext\Cli;

(static function (): void {
    foreach ([
        $GLOBALS['_composer_autoload_path'] ?? null, // set by Composer's bin proxy
        __DIR__ . '/../vendor/autoload.php', // installed as the root package
        __DIR__ . '/../../../autoload.php', // installed as a dependency (vendor/bin)
    ] as $autoload) {
        if (is_string($autoload) && is_file($autoload)) {
            require $autoload;

            return;
        }
    }
})();

if (!class_exists(Cli::class)) {
    fwrite(STDERR, "Could not locate the Composer autoloader. Run 'composer install' first.\n");

    exit(1);
}

/** @var list<string> $argv */
exit((new Cli())($argv));
