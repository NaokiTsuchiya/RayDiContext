{
    "name": "naoki-tsuchiya/ray-di-context",
    "description": "Context, meta, and compile management for Ray.Di applications with separated read-only compile dir and writable tmp dir",
    "license": "MIT",
    "keywords": [
        "di",
        "ray.di",
        "dependency-injection",
        "compiler",
        "context"
    ],
    "authors": [
        {
            "name": "Naoki Tsuchiya"
        }
    ],
    "support": {
        "issues": "https://github.com/NaokiTsuchiya/RayDiContext/issues",
        "source": "https://github.com/NaokiTsuchiya/RayDiContext"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ray/di": "^2.19",
        "ray/compiler": "^1.15"
    },
    "require-dev": {
        "carthage-software/mago": "1.46.0",
        "infection/infection": "0.32.6",
        "phpunit/phpunit": "11.5.56"
    },
    "bin": [
        "bin/ray-di-compile"
    ],
    "autoload": {
        "psr-4": {
            "NaokiTsuchiya\\RayDiContext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NaokiTsuchiya\\RayDiContext\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "dist": "tests/dist-check.sh",
        "gitattributes-check": "tests/gitattributes-check.sh",
        "lowest-check": "@php tests/lowest-bound-check.php",
        "ci-matrix-check": "tests/ci-matrix-check.sh",
        "changelog-check": "tests/changelog-check.sh",
        "ci-status-check": "tests/ci-status-check.sh",
        "tag-release-workflow-check": "tests/tag-release-workflow-check.sh",
        "lint": "mago lint --minimum-fail-level note",
        "analyze": "mago analyze",
        "guard": "mago guard",
        "fmt": [
            "mago fmt --check",
            "mago fmt --check bin/ray-di-compile"
        ],
        "cs": [
            "@lint",
            "@fmt"
        ],
        "sa": [
            "@analyze",
            "@guard"
        ],
        "tests": [
            "@cs",
            "@sa",
            "@test",
            "@dist",
            "@gitattributes-check",
            "@ci-matrix-check",
            "@changelog-check",
            "@ci-status-check",
            "@tag-release-workflow-check"
        ],
        "infection": "infection --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
