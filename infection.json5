{
    "source": {
        "directories": ["src"],
    },
    "mutators": {
        "@default": true,
        // BakedPathScanner's scan offset: see docs/decisions.md "Why two kinds of mutants are ignored".
        "IncrementInteger": {
            "ignore": [
                "NaokiTsuchiya\\RayDiContext\\BakedPathScanner::hasBakedPath",
                "NaokiTsuchiya\\RayDiContext\\BakedPathScanner::compileDirRanges",
            ],
        },
        // Cli::write()'s suppressed warning: see docs/decisions.md "Why two kinds of mutants
        // are ignored".
        "TrueValue": {
            "ignore": [
                "NaokiTsuchiya\\RayDiContext\\Cli::write",
            ],
        },
        // Cli::write()'s try/finally: see docs/decisions.md "Why two kinds of mutants are ignored".
        "UnwrapFinally": {
            "ignore": [
                "NaokiTsuchiya\\RayDiContext\\Cli::write",
            ],
        },
    },
    // BinCompileIntegrationTest runs in a separate process and contributes zero measured
    // coverage either way; composer test still runs it (see docs/decisions.md #140).
    "testFrameworkOptions": "--exclude-group=infection-excluded",
    "minMsi": 100.0,
    "minCoveredMsi": 100.0,
}
